import Lean.Elab.Tactic.ElabTerm

/-! Expose the kernel exception hidden by `decide +kernel`'s elaborator-side
diagnostic when irreducible rational operations also block the elaborator.
This tactic constructs the same `mkDecideProof` and sends it to `mkAuxLemma`;
there is no native evaluation, trusted verdict, or additional axiom. It supports
only the closed monomorphic propositions generated by this experiment. -/
open Lean Meta Elab Tactic

elab "pcs_kernel_decide_raw" : tactic => do
  closeMainGoalUsing `pcs_kernel_decide_raw fun expectedType _ => do
    let expectedType ← instantiateMVars expectedType
    if expectedType.hasFVar || expectedType.hasMVar then
      throwError "Closed proposition required"
    let levels := (collectLevelParams {} expectedType).params
    if !levels.isEmpty then
      throwError "Monomorphic proposition required"
    let pf ← mkDecideProof expectedType
    let name ← withOptions (Elab.async.set · false) do
      mkAuxLemma [] expectedType pf
    return mkConst name

@[inline] def look (a : Array (ℤ × ℕ)) (i : ℕ) : ℚ :=
  let p := a.getD i (0, 0); (p.1 : ℚ) / (2 : ℚ) ^ p.2

def ucert : UpperCert 2 where
  jB := 1
  lvl := 40
  zero := zero
  box := ![15, 40]
  T := fun x => look Ttab (x 0 * 40 + x 1 * 1)
  C := ((10995116277760000000000000000000000000000000000000000 : ℚ) / 77405494483928356601681434130536198019976749447352801)
  ρ := ![((3 : ℚ) / 2), ((21 : ℚ) / 20)]

def lcert : LowerCert 2 where
  jB := 1
  lvl := 40
  box := ![15, 40]
  F := fun x => look Ftab (x 0 * 40 + x 1 * 1)
  V := fun x => look Vtab (x 0 * 40 + x 1 * 1)

def x0 : Fin 2 → ℕ := ![0, 1]

theorem upper_ok : net.checkUpper ucert = true := by
  decide +kernel

theorem lower_ok : net.checkLower (tabooA zero) lcert = true := by
  decide +kernel

theorem upper_val : ucert.g x0 ≤ ((61321557 : ℚ) / 10000000000000) := by
  decide +kernel

theorem lower_val : ((3066077 : ℚ) / 500000000000) ≤ lcert.f (tabooA zero) x0 := by
  decide +kernel

/-- **Certified sandwich** for the infinite-state network: the probability that
species 1 reaches 40 before extinction of a taboo species, from `x0`. -/
theorem sandwich :
    ((3066077 : ℝ) / 500000000000) ≤
      net.toJump.hitProb {y | tabooA zero y = true} {y | 40 ≤ y 1} x0 ∧
    net.toJump.hitProb {y | tabooA zero y = true} {y | 40 ≤ y 1} x0 ≤
      ((61321557 : ℝ) / 10000000000000) := by
  have hU := net.checkUpper_sound upper_ok x0
  have hL := net.checkLower_sound lower_ok x0
  have hu : ((ucert.g x0 : ℚ) : ℝ) ≤ ((61321557 : ℚ) / 10000000000000 : ℚ) := by exact_mod_cast upper_val
  have hl : ((3066077 : ℚ) / 500000000000 : ℚ) ≤ ((lcert.f (tabooA zero) x0 : ℚ) : ℝ) := by exact_mod_cast lower_val
  push_cast at hu hl
  exact ⟨le_trans hl hL, le_trans hU hu⟩

end AION.Examples.GeneCert

@[inline] def look (a : Array (ℤ × ℕ)) (i : ℕ) : ℚ :=
  let p := a.getD i (0, 0); (p.1 : ℚ) / (2 : ℚ) ^ p.2

def ucert : UpperCert 2 where
  jB := 0
  lvl := 20
  zero := zero
  box := ![20, 40]
  T := fun x => look Ttab (x 0 * 40 + x 1 * 1)
  C := ((1 : ℚ) / 1048576)
  ρ := ![(2 : ℚ), ((11 : ℚ) / 10)]

def lcert : LowerCert 2 where
  jB := 0
  lvl := 20
  box := ![20, 40]
  F := fun x => look Ftab (x 0 * 40 + x 1 * 1)
  V := fun x => look Vtab (x 0 * 40 + x 1 * 1)

def x0 : Fin 2 → ℕ := ![1, 10]

theorem upper_ok : net.checkUpper ucert = true := by
  decide +kernel

theorem lower_ok : net.checkLower (tabooA zero) lcert = true := by
  decide +kernel

theorem upper_val : ucert.g x0 ≤ ((12639073 : ℚ) / 2500000000000) := by
  decide +kernel

theorem lower_val : ((50556279 : ℚ) / 10000000000000) ≤ lcert.f (tabooA zero) x0 := by
  decide +kernel

/-- **Certified sandwich** for the infinite-state network: the probability that
species 0 reaches 20 before extinction of a taboo species, from `x0`. -/
theorem sandwich :
    ((50556279 : ℝ) / 10000000000000) ≤
      net.toJump.hitProb {y | tabooA zero y = true} {y | 20 ≤ y 0} x0 ∧
    net.toJump.hitProb {y | tabooA zero y = true} {y | 20 ≤ y 0} x0 ≤
      ((12639073 : ℝ) / 2500000000000) := by
  have hU := net.checkUpper_sound upper_ok x0
  have hL := net.checkLower_sound lower_ok x0
  have hu : ((ucert.g x0 : ℚ) : ℝ) ≤ ((12639073 : ℚ) / 2500000000000 : ℚ) := by exact_mod_cast upper_val
  have hl : ((50556279 : ℚ) / 10000000000000 : ℚ) ≤ ((lcert.f (tabooA zero) x0 : ℚ) : ℝ) := by exact_mod_cast lower_val
  push_cast at hu hl
  exact ⟨le_trans hl hL, le_trans hU hu⟩

end AION.Examples.XYsmall

    },
    {
      "id": "E2",
      "prompt": "Handle packages signed after compromise time.",
      "acceptable_keywords": [
        "re-review",
        "re-sign",
        "identify packages",
        "do not silently trust"
      ]
    },
    {
      "id": "E3",
      "prompt": "Before distributing replacement fingerprint.",
      "acceptable_keywords": [
        "trusted channel",
        "independent channel",
        "pin fingerprint",
        "replacement key"
      ]
    }
  ],
  "after_action_criteria": [

{
  "scenario_id": "TT-06",
  "title": "Premature public disclosure of unpublished pilot results",
  "offline_only": true,
  "touches_live_credentials": false,
  "touches_live_infra": false,
  "incident": {
    "summary": "A draft certificate and limitations file appeared on a public paste site before embargo lift.",
    "indicators": ["Public URL", "Matching semantic_hash fragment"],

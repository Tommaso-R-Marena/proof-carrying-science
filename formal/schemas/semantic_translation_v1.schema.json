{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.invalid/schemas/semantic_translation_v1.schema.json",
  "title": "PCS Semantic Translation Contract v1 — request, authority configuration and decision",
  "description": "Wire format read and written by pcs-semantic-check. All documents must be canonical JSON (RFC 8785 fragment: keys sorted, no insignificant whitespace, integers only). The Lean decoder is strict: every object must have exactly the listed members (additionalProperties false); anything else is MALFORMED_INPUT. This schema is documentation and a pre-flight check for producers; the authoritative decoder is PCS.V2.TranslationJson.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/authority" },
    { "$ref": "#/$defs/decision" }
  ],
  "$defs": {
    "strs": { "type": "array", "items": { "type": "string" } },
    "term": {
      "oneOf": [
        { "type": "object", "required": ["var"], "additionalProperties": false,
          "properties": { "var": { "type": "string" } } },
        { "type": "object", "required": ["args", "fn"], "additionalProperties": false,
          "properties": { "args": { "type": "array", "items": { "$ref": "#/$defs/term" } },
                          "fn": { "type": "string" } } }
      ]
    },
    "formula": {
      "oneOf": [
        { "type": "object", "required": ["op"], "additionalProperties": false,
          "properties": { "op": { "enum": ["true", "false"] } } },
        { "type": "object", "required": ["args", "op", "symbol"], "additionalProperties": false,
          "properties": { "args": { "type": "array", "items": { "$ref": "#/$defs/term" } },
                          "op": { "const": "pred" }, "symbol": { "type": "string" } } },
        { "type": "object", "required": ["lhs", "op", "rhs"], "additionalProperties": false,
          "properties": { "lhs": { "$ref": "#/$defs/term" }, "op": { "enum": ["eq", "ne"] },
                          "rhs": { "$ref": "#/$defs/term" } } },
        { "type": "object", "required": ["arg", "op"], "additionalProperties": false,
          "properties": { "arg": { "$ref": "#/$defs/formula" }, "op": { "const": "not" } } },
        { "type": "object", "required": ["lhs", "op", "rhs"], "additionalProperties": false,
          "properties": { "lhs": { "$ref": "#/$defs/formula" }, "op": { "enum": ["and", "or", "implies"] },
                          "rhs": { "$ref": "#/$defs/formula" } } },
        { "type": "object", "required": ["body", "op", "sort", "var"], "additionalProperties": false,
          "properties": { "body": { "$ref": "#/$defs/formula" }, "op": { "enum": ["forall", "exists"] },
                          "sort": { "type": "string" }, "var": { "type": "string" } } },
        { "type": "object", "required": ["construct", "op"], "additionalProperties": false,
          "description": "Any construct outside the supported fragment. Always rejected (UNSUPPORTED_CONSTRUCT).",
          "properties": { "construct": { "type": "string" }, "op": { "const": "unsupported" } } }
      ]
    },
    "binder": { "type": "object", "required": ["name", "sort"], "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "sort": { "type": "string" } } },
    "claim": { "type": "object", "required": ["assumptions", "conclusion", "params"], "additionalProperties": false,
      "properties": { "assumptions": { "type": "array", "items": { "$ref": "#/$defs/formula" } },
                      "conclusion": { "$ref": "#/$defs/formula" },
                      "params": { "type": "array", "items": { "$ref": "#/$defs/binder" } } } },
    "ambiguity": { "type": "object", "required": ["id", "kind", "question", "resolution"], "additionalProperties": false,
      "properties": { "id": { "type": "string" },
                      "kind": { "enum": ["scope", "lexical", "symbol", "temporal", "referent", "other"] },
                      "question": { "type": "string" },
                      "resolution": { "type": ["string", "null"], "description": "null = unresolved (NEEDS_CLARIFICATION)" } } },
    "interpretation": { "type": "object",
      "required": ["ambiguities", "model_asserts_confirmed", "proposer", "selected", "source_text"],
      "additionalProperties": false,
      "properties": { "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } },
                      "model_asserts_confirmed": { "type": "boolean", "description": "Untrusted; never read by the checker." },
                      "proposer": { "type": "string", "description": "Untrusted metadata; never read by the checker." },
                      "selected": { "$ref": "#/$defs/claim" },
                      "source_text": { "type": "string", "description": "Natural-language text; never interpreted." } } },
    "symbolRef": { "type": "object", "required": ["lean_name", "provenance", "symbol"], "additionalProperties": false,
      "properties": { "lean_name": { "type": "string" }, "provenance": { "type": "string" }, "symbol": { "type": "string" } } },
    "symbolEntry": { "type": "object", "required": ["args", "id", "kind", "lean_name", "provenance", "result"],
      "additionalProperties": false,
      "properties": { "args": { "$ref": "#/$defs/strs" }, "id": { "type": "string" }, "kind": { "enum": ["pred", "fn"] },
                      "lean_name": { "type": "string" }, "provenance": { "type": "string" },
                      "result": { "type": ["string", "null"], "description": "null for predicates, result sort for functions" } } },
    "sortEntry": { "type": "object", "required": ["id", "lean_type", "provenance"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "lean_type": { "type": "string" }, "provenance": { "type": "string" } } },
    "explNode": { "type": "object", "required": ["role"],
      "properties": { "role": { "enum": ["always", "never", "atom", "equal", "not_equal", "negation", "all_of",
        "any_of", "if_then", "for_every", "there_exists", "unsupported"] } } },
    "explanation": { "type": "object",
      "required": ["assumptions", "conclusion", "negations", "not_established", "quantifiers", "references",
                   "sort_references", "trust_boundary", "variables"],
      "additionalProperties": false,
      "properties": { "assumptions": { "type": "array", "items": { "$ref": "#/$defs/explNode" } },
                      "conclusion": { "$ref": "#/$defs/explNode" },
                      "negations": { "type": "integer", "minimum": 0 },
                      "not_established": { "$ref": "#/$defs/strs" },
                      "quantifiers": { "type": "array", "items": { "type": "object",
                        "required": ["quantifier", "sort", "var"], "additionalProperties": false,
                        "properties": { "quantifier": { "enum": ["forall", "exists"] },
                                        "sort": { "type": "string" }, "var": { "type": "string" } } } },
                      "references": { "type": "array", "items": { "$ref": "#/$defs/symbolEntry" } },
                      "sort_references": { "type": "array", "items": { "$ref": "#/$defs/sortEntry" } },
                      "trust_boundary": { "$ref": "#/$defs/strs" },
                      "variables": { "type": "array", "items": { "$ref": "#/$defs/binder" } } } },
    "candidate": { "type": "object",
      "required": ["claim", "decl_name", "explanation", "groundings", "lean_source", "model_confidence", "proposer"],
      "additionalProperties": false,
      "properties": { "claim": { "$ref": "#/$defs/claim" },
                      "decl_name": { "type": "string" },
                      "explanation": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/explanation" } ] },
                      "groundings": { "type": "array", "items": { "$ref": "#/$defs/symbolRef" } },
                      "lean_source": { "type": "string" },
                      "model_confidence": { "type": "integer", "minimum": 0, "description": "Untrusted; never read by the checker." },
                      "proposer": { "type": "string", "description": "Untrusted metadata; never read by the checker." } } },
    "confirmation": { "type": "object", "required": ["ambiguities", "authority", "selected", "signature", "source_text"],
      "additionalProperties": false,
      "description": "Ed25519 signature (base64) by an authorized confirmation key (authority = base64 public key) over 'pcs-semantic-confirmation-v1\\n' + canonical {ambiguities, selected, source_text}.",
      "properties": { "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } },
                      "authority": { "type": "string" }, "selected": { "$ref": "#/$defs/claim" },
                      "signature": { "type": "string" }, "source_text": { "type": "string" } } },
    "elaboration": { "type": "object", "required": ["authority", "decl_name", "lean_source", "signature"],
      "additionalProperties": false,
      "description": "Ed25519 signature by an authorized elaboration key over 'pcs-semantic-elaboration-v1\\n' + canonical {decl_name, lean_source}.",
      "properties": { "authority": { "type": "string" }, "decl_name": { "type": "string" },
                      "lean_source": { "type": "string" }, "signature": { "type": "string" } } },
    "proof": { "type": "object", "required": ["authority", "axioms", "decl_name", "lean_source", "signature"],
      "additionalProperties": false,
      "description": "Ed25519 signature by an authorized proof key over 'pcs-semantic-proof-v1\\n' + canonical {axioms, decl_name, lean_source}.",
      "properties": { "authority": { "type": "string" }, "axioms": { "$ref": "#/$defs/strs" },
                      "decl_name": { "type": "string" }, "lean_source": { "type": "string" },
                      "signature": { "type": "string" } } },
    "request": { "type": "object",
      "required": ["candidate", "confirmation", "elaboration", "interpretation", "proof", "schema"],
      "additionalProperties": false,
      "properties": { "candidate": { "$ref": "#/$defs/candidate" },
                      "confirmation": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/confirmation" } ] },
                      "elaboration": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/elaboration" } ] },
                      "interpretation": { "$ref": "#/$defs/interpretation" },
                      "proof": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/proof" } ] },
                      "schema": { "const": "pcs-semantic-translation-v1" } } },
    "authority": { "type": "object",
      "required": ["allowed_axioms", "confirmation_keys", "elaboration_keys", "proof_keys", "registry",
                   "require_elaboration", "require_proof", "schema"],
      "additionalProperties": false,
      "properties": { "allowed_axioms": { "$ref": "#/$defs/strs" },
                      "confirmation_keys": { "$ref": "#/$defs/strs" },
                      "elaboration_keys": { "$ref": "#/$defs/strs" },
                      "proof_keys": { "$ref": "#/$defs/strs" },
                      "registry": { "type": "object", "required": ["sorts", "symbols"], "additionalProperties": false,
                        "properties": { "sorts": { "type": "array", "items": { "$ref": "#/$defs/sortEntry" } },
                                        "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbolEntry" } } } },
                      "require_elaboration": { "type": "boolean" },
                      "require_proof": { "type": "boolean" },
                      "schema": { "const": "pcs-semantic-authority-v1" } } },
    "decision": { "type": "object",
      "required": ["diagnostics", "expected_lean_source", "explanation", "explanation_literal", "schema", "verdict"],
      "additionalProperties": false,
      "properties": { "diagnostics": { "type": "array", "items": { "type": "object",
                        "required": ["code", "component", "detail"], "additionalProperties": false,
                        "properties": { "code": { "enum": ["AMBIGUOUS_SCOPE", "UNRESOLVED_AMBIGUITY", "CONFIRMATION_MISSING",
                          "CONFIRMATION_NOT_VERIFIED", "REGISTRY_MALFORMED", "UNRESOLVED_SYMBOL", "UNKNOWN_DEFINITION",
                          "INCORRECT_SYMBOL_IDENTITY", "DUPLICATE_OR_SHADOWED_GROUNDING", "ILL_TYPED",
                          "UNSUPPORTED_CONSTRUCT", "UNEXPECTED_FREE_VARIABLE", "BINDER_SHADOWING", "QUANTIFIER_MISMATCH",
                          "POLARITY_MISMATCH", "NEGATION_MISMATCH", "CONNECTIVE_MISMATCH", "ASSUMPTION_DROPPED",
                          "ASSUMPTION_ADDED", "BINDING_MISMATCH", "SEMANTIC_MISMATCH", "ROUNDTRIP_MISMATCH",
                          "LEAN_RENDERING_MISMATCH", "ELABORATION_NOT_VERIFIED", "PROOF_NOT_VERIFIED", "MALFORMED_INPUT"] },
                          "component": { "type": "string" }, "detail": { "type": "string" } } } },
                      "expected_lean_source": { "type": "string" },
                      "explanation": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/explanation" } ] },
                      "explanation_literal": { "type": ["string", "null"],
                        "description": "Deterministic literal English. Presentation only: NOT semantically certified." },
                      "schema": { "const": "pcs-semantic-decision-v1" },
                      "verdict": { "enum": ["ACCEPTED", "NEEDS_CLARIFICATION", "REJECTED"] } } }
  }
}

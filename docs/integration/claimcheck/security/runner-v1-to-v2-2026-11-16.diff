+CONDS = rf"\[(?:{COND}(?:, {COND})*)?\]"
+STAT = (rf"(?:\.count|\.sum|\.mean|\.median|\.min|\.max|\.varSample|\.sdSample|\.sdPop|\.sem|\.share {CONDS}"

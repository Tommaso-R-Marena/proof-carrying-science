+NAT = r"(?:0|[1-9][0-9]*)"
+INT = r"(?:0|-?[1-9][0-9]*)"                      # no "-0"
+BYTE = r"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])"

+COLUMN = rf"(?:none|some \({BYTES}\))"
+NALIST = rf"\[(?:{BYTES}(?:, {BYTES})*)?\]"
+VALUE = rf"(?:\(\.rat {RAT}\)|\(\.sqrt \((?:-1|0|1) : Int\) \(\({NAT} : Rat\) / [1-9][0-9]*\)\))"
+UNDEFINED = (r"(?:sourceNotWellFormed|csvMalformed|columnNotFound|nonNumericCell|emptySelection|degenerate"

+_SAFE_BYTES = frozenset(SAFE_CHARS.encode("ascii"))
+_QUOTED = re.compile(r'b "[^"]*"')
+_RAT_LITERAL = re.compile(r"\(\((-?[0-9]+) : Rat\) / ([0-9]+)\)")
+_BYTE_LIST = re.compile(r"\[([0-9]+(?:, [0-9]+)*)\]")
